{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MeridianDatabase": "Server=.;Database=Carbynetech_TimeSheet_Application;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Authentication": {
    "DevMode": true
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "MaxVerificationAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "Meridian",
    "Audience": "MeridianClients",
    "ExpiryMinutes": 480
  }
